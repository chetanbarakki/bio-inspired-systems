import numpy as np 
import random
data = np.array([
    [10, 20, 8,  5, 30],
    [12, 25, 9,  6, 35],
    [50, 80, 2, 40, 90],
    [55, 85, 1, 45, 95],
    [15, 22, 7,  8, 32],
    [60, 90, 1, 50, 100],
])

labels = np.array([0, 0, 1, 1, 0, 1])
def fitness(wolf):
    selected = np.where(wolf == 1)[0]
    if len(selected) == 0:
        return 999
    normal = data[labels == 0][:,selected]
    attack = data[labels == 1][:,selected]
    normal_mean = np.mean(normal,axis=0)
    attack_mean = np.mean(attack,axis=0)
    difference = np.mean(np.abs(attack_mean-normal_mean))
    score = -difference+0.1*len(selected)
    return score
n_wolves = 5
iterations = 20
n_features = data.shape[1]
wolves = np.random.randint(0,2,(n_wolves,n_features))
alpha = None
beta = None
delta = None
alpha_score = float('inf')
beta_score = float('inf')
delta_score = float('inf')
for t in range(iterations):
    for wolf in wolves:
        score = fitness(wolf)
        if score < alpha_score:
            delta_score, delta = beta_score,beta
            beta_score,beta = alpha_score, alpha
            alpha_score,alpha = score, wolf.copy()
        elif score < beta_score:
            delta_score, delta = beta_score,beta
            beta_score,beta = score, wolf.copy()
        elif score < delta_score:
            delta_score, delta = score, wolf.copy()
    a = 2-2*t/iterations
    for i in range(n_wolves):
        X = wolves[i].astype('float')
        A1 = 2 * a * random.random() - a
        C1 = 2 * random.random()
        D1 = abs(C1 * alpha - X)
        X1 = alpha - A1 * D1
        A2 = 2 * a * random.random() - a
        C2 = 2 * random.random()
        D2 = abs(C2 * beta - X)
        X2 = beta - A2 * D2
        A3 = 2 * a * random.random() - a
        C3 = 2 * random.random()
        D3 = abs(C3 * delta - X)
        X3 = delta - A3 * D3
        new_position = (X1+X2+X3)/3
        probability = 1 / (1 + np.exp(-np.clip(new_position, -50, 50)))
        wolves[i] = (np.random.random(n_features) < probability).astype(int)
    print("Iteration:", t + 1, "Best fitness:", alpha_score)
for i in range(n_features):
    if alpha[i] == 1:
        print("Feature", i + 1)

print("Best fitness:", alpha_score)
